# Copy to .env.local (gitignored). Every variable is optional in development.

# --- Error & alert reporting (src/lib/report.ts) ---
# Slack or Discord incoming-webhook URL. When set, client errors caught by the
# error boundaries and failed/unconfigured lead deliveries are pushed here in
# addition to the server log.
ALERT_WEBHOOK_URL=

# --- Image generation for the /fr/images-test-pour-voir comparison page ---
# Used only by scripts/gen-images.mjs (never by the running site).
OPENAI_API_KEY=

# --- Contact form transport (src/app/api/contact/route.ts) ---
# See the comment block at the top of the route for RESEND_API_KEY,
# CONTACT_TO, CONTACT_FROM and CONTACT_PLACEHOLDER.
